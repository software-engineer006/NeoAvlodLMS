# Production Environment Configuration for NeoAvlod LMS
# Copy this file to .env.production and provide real secrets.
# NEVER commit .env.production or any real secrets to Git.

# PostgreSQL 18.6 configuration
POSTGRES_USER=neoavlod
POSTGRES_DB=neoavlod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Host port for backend API (bound locally; reverse proxied by Nginx)
API_PORT=8000

# NeoAvlod application settings
NEOAVLOD_ENVIRONMENT=production
NEOAVLOD_DEBUG=false

# PostgreSQL asyncpg connection string (matches POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB)
NEOAVLOD_DATABASE_URL=postgresql+asyncpg://neoavlod:REPLACE_WITH_STRONG_DB_PASSWORD@database:5432/neoavlod

# Security Secret (minimum 32 characters, used for HMAC signatures, OTP hashing and cookie encryption)
# Generate with: openssl rand -hex 32
NEOAVLOD_SECURITY_SECRET=REPLACE_WITH_HEX_32_OR_LONGER_SECRET

# Bot Encryption Key (valid 32-byte Fernet key for encrypting Telegram bot token at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEOAVLOD_BOT_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Production portal origins (must use HTTPS)
NEOAVLOD_ADMIN_ORIGIN=https://admin.eduneo.uz
NEOAVLOD_TEACHER_ORIGIN=https://teacher.eduneo.uz
