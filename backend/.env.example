# Copy to backend/.env for local development. Production values come from secrets.
NEOAVLOD_APP_NAME="NeoAvlod LMS"
NEOAVLOD_ENVIRONMENT=development
NEOAVLOD_DEBUG=false
# Compose supplies the DB URL; override only with another Docker PostgreSQL.
# NEOAVLOD_DATABASE_URL=postgresql+asyncpg://user:password@database:5432/neoavlod
# Telegram encryption and session settings are added in their tasks.
